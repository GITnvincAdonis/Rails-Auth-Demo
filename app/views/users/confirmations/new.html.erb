<% content_for :title, "Resend Confirmation" %>

<div class="w-full space-y-5 rounded-md p-10 w-full lg:w-2/3 xl:w-2/6">
  <section>
    <div class="mb-6">
      <h1 class="text-center text-2xl font-semibold uppercase">Resend confirmation</h1>
      <p class="mt-2 text-sm text-neutral-600">We'll send you a new link to confirm your account.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-4" }) do |form| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="space-y-1.5">
        <%= form.label :email, class: form_label_class %>
        <%= form.email_field :email,
          autofocus: true,
          autocomplete: "email",
          value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
          class: form_field_class,
          placeholder: "admin@example.com" %>
      </div>

      <%= form.submit "Resend confirmation instructions", class: "#{call_to_action_button_large} w-full" %>
    <% end %>

    <%= render "users/shared/links" %>
  </section>
</div>
