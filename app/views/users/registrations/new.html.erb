<% content_for :title, "Create Admin Account" %>

<div class="w-full space-y-5 rounded-md p-10 w-full lg:w-2/3 xl:w-2/6">
  <section>
    <div class="mb-6">
      <h1 class="text-center text-2xl font-semibold uppercase">Create account</h1>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |form| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="space-y-1.5">
        <%= form.label :email, class: form_label_class %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: form_field_class, placeholder: "admin@example.com" %>
      </div>

      <div class="space-y-1.5">
        <%= form.label :password, class: form_label_class %>
        <%= form.password_field :password, autocomplete: "new-password", class: form_field_class, placeholder: "Create a password" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-neutral-500"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div class="space-y-1.5">
        <%= form.label :password_confirmation, class: form_label_class %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: form_field_class, placeholder: "Confirm your password" %>
      </div>

      <%= form.submit "Sign up", class: "#{call_to_action_button_large} w-full" %>
    <% end %>

    <%= render "users/shared/links" %>
  </section>
</div>
