<% content_for :title, "Reset Password" %>

<div class="w-full space-y-5 rounded-md p-10 w-full lg:w-2/3 xl:w-2/6">
  <section>
    <div class="mb-6">
      <h1 class="text-center text-2xl font-semibold uppercase">Reset password</h1>
      <p class="mt-2 text-sm text-neutral-600">We'll email you instructions to choose a new password.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |form| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="space-y-1.5">
        <%= form.label :email, class: form_label_class %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: form_field_class, placeholder: "admin@example.com" %>
      </div>

      <%= form.submit "Send reset instructions", class: "#{call_to_action_button_large} w-full" %>
    <% end %>

    <%= render "users/shared/links" %>
  </section>
</div>
